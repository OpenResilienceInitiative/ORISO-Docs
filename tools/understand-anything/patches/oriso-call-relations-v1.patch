@@ -0,0 +1,131 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import type { GraphEdge, GraphNode } from "@understand-anything/core/types";
+import CallRelationsPanel from "../OrisoCallRelations";
+import { I18nProvider } from "../../contexts/I18nContext";
+
+const OrisoCallRelations = (props: Parameters<typeof CallRelationsPanel>[0] & {language?: string}) =>
+  createElement(I18nProvider, {language: props.language ?? "en", children: createElement(CallRelationsPanel, props)});
+import { callRelations } from "../orisoCallModel";
+
+const fn = (id: string, name: string): GraphNode => ({ id, type: "function", name, summary: "", tags: [], complexity: "simple" });
+const edge = (type: string, source: string, target: string, metadata?: Record<string, unknown>) =>
+  ({ type, source, target, direction: "forward", weight: 1, ...(metadata ? { metadata } : {}) }) as unknown as GraphEdge;
+
+const setup = fn("function:KeycloakService.java:KeycloakService.setUpOtpCredential(String,String,String)", "setUpOtpCredential");
+const delegate = fn("function:UserTwoFactorAuthControllerDelegate.java:Delegate.setUp()", "setUp");
+const facade = fn("function:TwoFactorFacade.java:Facade.enable()", "enable");
+const client = fn("function:KeycloakClient.java:KeycloakClient.putForEntity(String,String,Object,Class)", "putForEntity");
+const overload = fn("function:KeycloakClient.java:KeycloakClient.putForEntity(String,Object)", "putForEntity");
+const nodes = [setup, delegate, facade, client, overload];
+
+const edges: GraphEdge[] = [
+  edge("calls", delegate.id, setup.id, { lineNumber: 40 }),
+  edge("calls_unconfirmed", facade.id, setup.id, { reason: "java-typechecking-unavailable", lineNumber: 12 }),
+  edge("calls", setup.id, client.id, { lineNumber: 7 }),
+  edge("calls_unconfirmed", setup.id, client.id, { lineNumber: 9 }),
+  edge("contains", "file:KeycloakService.java", setup.id),
+  edge("imports", "file:A.java", "file:B.java"),
+];
+
+describe("callRelations", () => {
+  it("splits callers and callees with direction and keeps possible calls qualified", () => {
+    const r = callRelations(setup.id, edges, nodes);
+    expect(r.callers.map((c) => [c.name, c.possible])).toEqual([["setUp", false], ["enable", true]]);
+    expect(r.callers[1].reason).toBe("java-typechecking-unavailable");
+    expect(r.callees).toHaveLength(2);
+  });
+
+  it("retains confirmed and possible call sites separately for the same target", () => {
+    expect(callRelations(setup.id, edges, nodes).callees.map(r => [r.nodeId, r.possible, r.lineNumbers])).toEqual([
+      [client.id, false, [7]], [client.id, true, [9]],
+    ]);
+  });
+
+  it("overloads keep distinct identities and containment is never a call", () => {
+    const r = callRelations(overload.id, edges, nodes);
+    expect(r).toEqual({ callers: [], callees: [] });
+    expect(callRelations("file:KeycloakService.java", edges, nodes)).toEqual({ callers: [], callees: [] });
+  });
+
+  it("an unknown target keeps its id instead of inventing a name", () => {
+    const r = callRelations(setup.id, [edge("calls", setup.id, "function:Gone.java:gone()")], nodes);
+    expect(r.callees[0].name).toBe("function:Gone.java:gone()");
+  });
+});
+
+describe("OrisoCallRelations", () => {
+  const render = (showPossible: boolean, unresolvedCalls?: number) =>
+    renderToStaticMarkup(createElement(OrisoCallRelations, {
+      relations: callRelations(setup.id, edges, nodes), showPossible, onTogglePossible: () => {}, onOpen: () => {}, unresolvedCalls,
+    }));
+
+  it("shows possible calls with a label when included", () => {
+    const html = render(true);
+    expect(html).toContain("Called by (1 + 1 possible)");
+    expect(html).toContain("enable");
+    expect(html).toContain(">possible<");
+    expect(html).toContain("Include possible calls");
+  });
+
+  it("hides possible calls without dropping confirmed ones", () => {
+    const html = render(false);
+    expect(html).toContain("setUp");
+    expect(html).not.toContain("enable");
+    expect(html).toContain("Called by (1 + 1 possible)");
+  });
+
+  it("states that unresolved extraction is not proof of no calls", () => {
+    expect(render(true, 147611)).toContain("147,611 calls in this graph could not be resolved");
+    const empty = renderToStaticMarkup(createElement(OrisoCallRelations, {
+      relations: { callers: [], callees: [] }, showPossible: true, onTogglePossible: () => {}, onOpen: () => {},
+    }));
+    expect(empty).toContain("No caller found in the extracted source.");
+    expect(empty).not.toContain("Include possible calls");
+  });
+});
+
+
+describe("reader navigation identity", () => {
+  it("shows the qualified target identity as readable text, not only a mouse tooltip", () => {
+    const html = renderToStaticMarkup(createElement(OrisoCallRelations, {
