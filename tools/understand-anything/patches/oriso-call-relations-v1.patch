diff --git a/understand-anything-plugin/packages/dashboard/src/components/OrisoCallRelations.tsx b/understand-anything-plugin/packages/dashboard/src/components/OrisoCallRelations.tsx
new file mode 100644
index 0000000..a35e423
--- /dev/null
+++ b/understand-anything-plugin/packages/dashboard/src/components/OrisoCallRelations.tsx
@@ -0,0 +1,114 @@
+import { useState } from "react";
+import type { CallRelation, CallRelations } from "./orisoCallModel";
+
+import { useI18n } from "../contexts/I18nContext";
+
+const labels = {
+  en: { calls: "Calls", callers: "Called by", possible: "possible", include: "Include possible calls",
+    emptyCaller: "No caller found in the extracted source.", emptyCallee: "No callee found in the extracted source.",
+    onlyPossible: "Only possible calls; shown when included.", notChecked: "not type-checked",
+    explanation: "Source-resolved calls use narrow static source rules. Neither source-resolved nor possible calls are verified by a compiler, type checker or runtime.",
+    emptyWarning: "An empty list is not proof of no calls.",
+    unresolved: (count: number) => `${count.toLocaleString("en")} calls in this graph could not be resolved, so an empty list is not proof of no calls.`,
+    more: (next: number, remaining: number) => `Show ${next} more (${remaining} remaining)`,
+  },
+  de: { calls: "Ruft auf", callers: "Aufgerufen von", possible: "möglich", include: "Mögliche Aufrufe einbeziehen",
+    emptyCaller: "In dieser Quellgeneration wurde kein Aufrufer gefunden.", emptyCallee: "In dieser Quellgeneration wurde kein Aufrufziel gefunden.",
+    onlyPossible: "Nur mögliche Aufrufe; sichtbar, wenn einbezogen.", notChecked: "nicht typgeprüft",
+    explanation: "Quellseitig aufgelöste Aufrufe nutzen enge statische Quellregeln. Weder sie noch mögliche Aufrufe sind durch Compiler, Typprüfung oder Laufzeit bestätigt.",
+    emptyWarning: "Eine leere Liste beweist nicht, dass keine Aufrufe existieren.",
+    unresolved: (count: number) => `${count.toLocaleString("de")} Aufrufe in diesem Graphen konnten nicht aufgelöst werden. Eine leere Liste beweist nicht, dass keine Aufrufe existieren.`,
+    more: (next: number, remaining: number) => `${next} weitere anzeigen (${remaining} verbleibend)`,
+  },
+};
+const useLabels = () => labels[useI18n().localeKey === "de" ? "de" : "en"];
+
+function RelationList({ title, relations, showPossible, onOpen, empty }: {
+  title: string;
+  relations: CallRelation[];
+  showPossible: boolean;
+  onOpen: (id: string) => void;
+  empty: string;
+}) {
+  const text = useLabels();
+  const [limit, setLimit] = useState(25);
+  const visible = relations.filter((r) => showPossible || !r.possible);
+  const possible = relations.filter((r) => r.possible).length;
+  return (
+    <section className="mb-3" aria-label={title}>
+      <h4 className="text-[10px] font-semibold text-text-secondary uppercase tracking-wider mb-1.5">
+        {title} ({relations.length - possible}{possible ? ` + ${possible} ${text.possible}` : ""})
+      </h4>
+      {visible.length === 0 ? (
+        <p className="text-[11px] text-text-muted">{relations.length ? text.onlyPossible : empty}</p>
+      ) : (
+        <ul className="space-y-1.5">
+          {visible.slice(0, limit).map((r) => (
+            <li key={`${r.nodeId}|${r.possible}`}>
+              <button
+                type="button"
+                className="w-full text-left text-xs bg-elevated rounded-lg px-3 py-2 border border-border-subtle flex items-center gap-2 hover:border-gold/40 hover:bg-gold/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold transition-colors"
+                onClick={() => onOpen(r.nodeId)}
+                title={r.nodeId}
+              >
+                <span className="min-w-0 flex-1">
+                  <span className="block text-text-primary break-words">{r.name}</span>
+                  <span className="block text-[10px] text-text-muted break-all">{r.nodeId}</span>
+                </span>
+                {r.lineNumbers.length > 0 && (
+                  <span className="text-[10px] text-text-muted font-mono shrink-0">L{r.lineNumbers.join(", ")}</span>
+                )}
+                {r.possible && (
+                  <span
+                    className="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded border border-dashed border-gold/50 text-gold shrink-0"
+                    title={r.reason === "java-typechecking-unavailable" ? text.notChecked : r.reason ?? text.possible}
+                  >
+                    {text.possible}
+                  </span>
+                )}
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+      {visible.length > limit && (
+        <button type="button" className="w-full text-xs text-gold border border-border-subtle rounded px-3 py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold"
+          onClick={() => setLimit(value => value + 25)}>
+          {text.more(Math.min(25, visible.length - limit), visible.length - limit)}
+        </button>
+      )}
+    </section>
+  );
+}
+
+export default function OrisoCallRelations({ relations, showPossible, onTogglePossible, onOpen, unresolvedCalls }: {
+  relations: CallRelations;
+  showPossible: boolean;
+  onTogglePossible: () => void;
+  onOpen: (id: string) => void;
+  unresolvedCalls?: number;
+}) {
+  const text = useLabels();
+  const possible = [...relations.callers, ...relations.callees].filter((r) => r.possible).length;
+  return (
+    <div className="mb-4" aria-label={text.calls}>
+      <div className="flex flex-wrap items-center gap-2 mb-2">
+        <h3 className="text-[11px] font-semibold text-gold uppercase tracking-wider">{text.calls}</h3>
+        {possible > 0 && (
+          <label className="ml-auto flex items-center gap-1.5 text-[10px] text-text-secondary cursor-pointer">
+            <input type="checkbox" checked={showPossible} onChange={onTogglePossible} />
+            {text.include}
+          </label>
+        )}
+      </div>
+      <RelationList title={text.callers} relations={relations.callers} showPossible={showPossible} onOpen={onOpen} empty={text.emptyCaller} />
+      <RelationList title={text.calls} relations={relations.callees} showPossible={showPossible} onOpen={onOpen} empty={text.emptyCallee} />
+      <p className="text-[10px] text-text-muted">
+        {text.explanation}
+        {typeof unresolvedCalls === "number" && unresolvedCalls > 0
+          ? ` ${text.unresolved(unresolvedCalls)}`
+          : ` ${text.emptyWarning}`}
+      </p>
+    </div>
+  );
+}
