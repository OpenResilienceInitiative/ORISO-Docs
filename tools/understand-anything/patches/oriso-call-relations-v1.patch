diff --git a/understand-anything-plugin/packages/dashboard/src/components/orisoCallModel.ts b/understand-anything-plugin/packages/dashboard/src/components/orisoCallModel.ts
new file mode 100644
index 0000000..cf75ee5
--- /dev/null
+++ b/understand-anything-plugin/packages/dashboard/src/components/orisoCallModel.ts
@@ -0,0 +1,51 @@
+import type { GraphEdge, GraphNode } from "@understand-anything/core/types";
+
+// Call relations of one node, read straight from the loaded edges. `calls` are confirmed;
+// `calls_unconfirmed` are possible (source-grounded but not type-checked) and stay labelled as
+// such. Containment is never a call, and nothing is added for unresolved extraction.
+export const CALL_EDGE_TYPES = ["calls", "calls_unconfirmed"] as const;
+
+export interface CallRelation {
+  nodeId: string;
+  name: string;
+  possible: boolean;
+  reason?: string;
+  lineNumbers: number[];
+}
+
+export interface CallRelations {
+  callers: CallRelation[];
+  callees: CallRelation[];
+}
+
+const isCallEdge = (edge: GraphEdge) => (CALL_EDGE_TYPES as readonly string[]).includes(edge.type);
+
+export function callRelations(nodeId: string, edges: GraphEdge[], nodes: GraphNode[]): CallRelations {
+  const names = new Map(nodes.map((n) => [n.id, n.name]));
+  const collect = (side: "source" | "target") => {
+    const other = side === "source" ? "target" : "source";
+    const byNode = new Map<string, CallRelation>();
+    for (const edge of edges) {
+      if (!isCallEdge(edge) || edge[side] !== nodeId) continue;
+      const id = edge[other];
+      const possible = edge.type === "calls_unconfirmed";
+      const metadata = (edge as { metadata?: { reason?: string; lineNumber?: number } }).metadata;
+      const key = `${id}|${edge.type}`;
+      const existing = byNode.get(key);
+      const relation = existing ?? { nodeId: id, name: names.get(id) ?? id, possible, lineNumbers: [] };
+      if (possible && metadata?.reason) relation.reason = metadata.reason;
+      if (typeof metadata?.lineNumber === "number" && !relation.lineNumbers.includes(metadata.lineNumber)) relation.lineNumbers.push(metadata.lineNumber);
+      byNode.set(key, relation);
+    }
+    return [...byNode.values()]
+      .map((r) => ({ ...r, lineNumbers: [...r.lineNumbers].sort((a, b) => a - b) }))
+      .sort((a, b) => Number(a.possible) - Number(b.possible) || a.name.localeCompare(b.name));
+  };
+  return { callees: collect("source"), callers: collect("target") };
+}
+
+export function hasCallRole(node: GraphNode) {
+  return node.type === "function" || node.type === "class";
+}
+
+export { isCallEdge };
