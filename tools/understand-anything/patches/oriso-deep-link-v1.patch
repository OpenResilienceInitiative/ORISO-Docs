diff --git a/understand-anything-plugin/packages/dashboard/src/components/OrisoDeepLink.tsx b/understand-anything-plugin/packages/dashboard/src/components/OrisoDeepLink.tsx
new file mode 100644
index 0000000..8485904
--- /dev/null
+++ b/understand-anything-plugin/packages/dashboard/src/components/OrisoDeepLink.tsx
@@ -0,0 +1,38 @@
+import { mapUrlForNode } from "../../deep-link.mjs";
+
+// Deep links (ORISO-Docs#199): "?node=<id>" opens this viewer on a node; these two
+// pieces are the visible parts. Plain classes only, so the page needs no inline style.
+
+export function OrisoShowOnMap({ nodeId }: { nodeId: string }) {
+  return (
+    <a
+      href={mapUrlForNode(nodeId)}
+      className="shrink-0 text-[10px] font-semibold px-2.5 py-1 rounded border border-accent/30 text-accent hover:text-accent-bright hover:border-accent/60 transition-colors"
+    >
+      Auf der Karte zeigen / Show on map
+    </a>
+  );
+}
+
+export function OrisoDeepLinkNotFound({ id, onDismiss }: { id: string; onDismiss: () => void }) {
+  return (
+    <div
+      role="status"
+      data-testid="deep-link-not-found"
+      className="px-3 sm:px-5 py-3 bg-elevated border-b border-border-subtle text-sm text-text-secondary flex flex-wrap items-center gap-x-3 gap-y-1"
+    >
+      <span className="font-medium text-text-primary">Knoten nicht gefunden / Node not found</span>
+      <code className="font-mono text-xs min-w-0 break-all">{id}</code>
+      <span className="min-w-0">
+        Dieser Graph enthält keinen Knoten mit dieser ID. / This graph has no node with this ID.
+      </span>
+      <button
+        type="button"
+        onClick={onDismiss}
+        className="shrink-0 text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded border border-border-subtle text-text-muted hover:text-gold hover:border-gold/30"
+      >
+        OK
+      </button>
+    </div>
+  );
+}
