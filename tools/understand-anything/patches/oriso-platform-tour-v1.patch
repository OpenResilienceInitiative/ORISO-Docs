diff --git a/understand-anything-plugin/packages/dashboard/src/components/OrisoPlatformOverview.tsx b/understand-anything-plugin/packages/dashboard/src/components/OrisoPlatformOverview.tsx
new file mode 100644
index 0000000..e3d7c3c
--- /dev/null
+++ b/understand-anything-plugin/packages/dashboard/src/components/OrisoPlatformOverview.tsx
@@ -0,0 +1,44 @@
+import type { KnowledgeGraph } from '@understand-anything/core/types';
+import { useI18n } from '../contexts/I18nContext';
+import { object, platformMetadata } from './orisoPlatformModel';
+
+export default function OrisoPlatformOverview({ graph, onSelect }: { graph: KnowledgeGraph; onSelect?: (id: string) => void }) {
+  const { localeKey } = useI18n();
+  const de = localeKey === 'de';
+  const metadata = platformMetadata(graph);
+  const data = object(metadata.platformNavigation).repositories;
+  if (!Array.isArray(data)) return null;
+  const repositories = data.map(object).filter(item => typeof item.repository === 'string');
+  const dispositions = Array.isArray(metadata.semanticDispositions) ? metadata.semanticDispositions.map(object) : [];
+  const nodes = new Set(graph.nodes.map(node => node.id));
+  const statusLabel = (status: unknown) => status === 'source-current' ? (de ? 'Quellenstand geprüft' : 'Source current') : status === 'stale' ? (de ? 'Erneute Prüfung nötig' : 'Stale — re-review required') : (de ? 'Prüfung ausstehend' : 'Awaiting review');
+  return <section aria-label={de ? 'Repository-Abdeckung' : 'Repository coverage'} className="min-w-0 mb-5 text-xs">
+    <h3 className="font-semibold text-accent mb-2">{de ? 'Repository-Abdeckung' : 'Repository coverage'}</h3>
+    <p className="text-text-muted mb-2">{de ? 'Enthaltene Quellen belegen keine aktive Bereitstellung oder Laufzeitprüfung.' : 'Included source does not establish deployment or runtime verification.'}</p>
+    <ul className="space-y-2">
+      {repositories.map(item => {
+        const repository = String(item.repository);
+        const available = item.status === 'included';
+        const href = available && typeof item.detailHref === 'string' && /^\/[a-z][a-z0-9-]*\/$/.test(item.detailHref) ? item.detailHref : null;
+        const id = typeof item.nodeId === 'string' && nodes.has(item.nodeId) ? item.nodeId : null;
+        return <li key={repository} className="min-w-0 rounded border border-border-subtle p-2">
+          <div className="flex flex-wrap items-center gap-2">
+            {available && id && onSelect ? <button onClick={() => onSelect(id)} className="text-accent underline break-all text-left">{repository}</button> : <span className="break-all">{repository}</span>}
+            <span>{available ? (de ? 'Enthalten' : 'Included') : (de ? 'Nicht verfügbar' : 'Unavailable')}</span>
+            {item.lifecycle === 'retired' && <span>{de ? 'Historische Quelle (stillgelegt)' : 'Historical source (retired)'}</span>}
+            {href && <a className="text-accent underline" href={href}>{de ? 'Detailgraph öffnen' : 'Open repository graph'}</a>}
+          </div>
+          {typeof item.sourceCommit === 'string' && /^[a-f0-9]{40}$/i.test(item.sourceCommit) && <code className="block break-all text-text-muted">{item.sourceCommit}</code>}
+        </li>;
+      })}
+    </ul>
+    {dispositions.length > 0 && <details className="mt-3">
+      <summary className="cursor-pointer text-accent">{de ? 'Semantische Einträge' : 'Semantic entries'} ({dispositions.length})</summary>
+      <p className="my-2 text-text-muted">{de ? 'Ein Quellenabgleich ist kein Laufzeitnachweis. Historische Erklärungen bleiben prüfpflichtig.' : 'Matching source is not runtime proof. Historical explanations still need review.'}</p>
+      <ul className="space-y-2">{dispositions.map((item, index) => <li key={String(item.nodeId ?? index)} className="min-w-0 break-words border border-border-subtle rounded p-2">
+        <span>{String(item.name ?? item.nodeId ?? '')}</span> — <strong>{statusLabel(item.status)}</strong>
+        <code className="block break-all text-text-muted">{String(item.repository ?? '')}::{String(item.nodeId ?? '')}</code>
+      </li>)}</ul>
+    </details>}
+  </section>;
+}
diff --git a/understand-anything-plugin/packages/dashboard/src/components/orisoPlatformModel.ts b/understand-anything-plugin/packages/dashboard/src/components/orisoPlatformModel.ts
new file mode 100644
index 0000000..6d2fa7a
--- /dev/null
+++ b/understand-anything-plugin/packages/dashboard/src/components/orisoPlatformModel.ts
@@ -0,0 +1,18 @@
+import type { KnowledgeGraph, TourStep } from '@understand-anything/core/types';
+
+export function platformMetadata(graph: KnowledgeGraph) {
+  const value = (graph as KnowledgeGraph & {metadata?: unknown}).metadata;
+  return object(value);
+}
+export function object(value: unknown): Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : {};
+}
+export function localizedPlatformTour(graph: KnowledgeGraph | null, locale: string): TourStep[] {
+  if (!graph) return [];
+  const steps = object(platformMetadata(graph).platformTour).steps;
+  return [...graph.tour].sort((a, b) => a.order - b.order).map(step => {
+    const authored = Array.isArray(steps) ? steps.find(item => object(item).order === step.order) : null;
+    const text = object(object(object(authored).locales)[locale === 'de' ? 'de' : 'en']);
+    return typeof text.title === 'string' && typeof text.description === 'string' ? { ...step, title: text.title, description: text.description } : step;
+  });
+}
diff --git a/understand-anything-plugin/packages/dashboard/src/components/__tests__/OrisoPlatformTour.test.ts b/understand-anything-plugin/packages/dashboard/src/components/__tests__/OrisoPlatformTour.test.ts
new file mode 100644
index 0000000..3793e5a
--- /dev/null
+++ b/understand-anything-plugin/packages/dashboard/src/components/__tests__/OrisoPlatformTour.test.ts
@@ -0,0 +1,47 @@
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { afterEach, expect, it } from 'vitest';
+import type { KnowledgeGraph } from '@understand-anything/core/types';
+import { I18nProvider } from '../../contexts/I18nContext';
+import { useDashboardStore } from '../../store';
+import LearnPanel from '../LearnPanel';
+import ProjectOverview from '../ProjectOverview';
+
+const graph: KnowledgeGraph & { metadata: Record<string, unknown> } = {
+  version: '1.0.0', kind: 'oriso-platform',
+  project: { name: 'ORISO-Platform', languages: [], frameworks: [], description: 'Fixture', analyzedAt: '2026-10-07', gitCommitHash: null },
+  nodes: [{ id: 'service:ORISO-UserService', type: 'service', name: 'UserService', summary: 'Source fixture', tags: [], complexity: 'simple' }], edges: [], layers: [],
+  tour: [{ order: 1, title: 'Entry points', description: 'Source only, not runtime proof', nodeIds: ['service:ORISO-UserService'] }],
+  metadata: {
+    platformTour: { steps: [{ order: 1, locales: { en: { title: 'Entry points', description: 'Source only, not runtime proof' }, de: { title: 'Einstiegspunkte', description: 'Nur Quellen, kein Laufzeitnachweis' } } }] },
+    platformNavigation: { repositories: [{ repository: 'ORISO-UserService', status: 'included', nodeId: 'service:ORISO-UserService', sourceCommit: 'a'.repeat(40), detailHref: '/user-service/' }, { repository: 'ORISO-Infra', status: 'unavailable', nodeId: null, sourceCommit: null, detailHref: null }, { repository: 'ORISO-Kubernetes', status: 'included', lifecycle: 'retired', nodeId: null, sourceCommit: 'b'.repeat(40), detailHref: '/kubernetes/' }] },
+    semanticDispositions: [{ repository: 'ORISO-UserService', nodeId: 'concept:case-handover', name: 'Case handover', status: 'awaiting-review', runtimeVerified: false }],
+  },
+};
+const initial = { ...useDashboardStore.getInitialState() };
+afterEach(() => { Object.assign(useDashboardStore.getInitialState(), initial); useDashboardStore.setState(initial); });
+const render = (component: typeof LearnPanel | typeof ProjectOverview, language: string) => renderToStaticMarkup(createElement(I18nProvider, { language, children: createElement(component) }));
+it('the actual tour shows the selected German text before and during navigation', () => {
+  useDashboardStore.setState({ graph, tourActive: false, currentTourStep: 0 });
+  Object.assign(useDashboardStore.getInitialState(), useDashboardStore.getState());
+  expect(render(LearnPanel, 'de')).toContain('Einstiegspunkte');
+  useDashboardStore.getState().startTour();
+  Object.assign(useDashboardStore.getInitialState(), useDashboardStore.getState());
+  const html = render(LearnPanel, 'de');
+  expect(html).toContain('Nur Quellen, kein Laufzeitnachweis');
+  expect(html).not.toContain('Source only, not runtime proof');
+  expect(html).toContain('Tour beenden');
+  expect(html).toContain('Referenzierte Komponenten');
+});
+it('the actual overview separates unavailable repositories and exposes exact revisions, detail routes and unreviewed concepts', () => {
+  Object.assign(useDashboardStore.getInitialState(), { graph });
+  const html = render(ProjectOverview, 'de');
+  expect(html).toContain('Repository-Abdeckung');
+  expect(html).toContain('href="/user-service/"');
+  expect(html).toContain('a'.repeat(40));
+  expect(html).toContain('Nicht verfügbar');
+  expect(html).toContain('Prüfung ausstehend');
+  expect(html).toContain('concept:case-handover');
+  expect(html).not.toContain('href="/infra/"');
+  expect(html).toContain('Historische Quelle (stillgelegt)');
+});
