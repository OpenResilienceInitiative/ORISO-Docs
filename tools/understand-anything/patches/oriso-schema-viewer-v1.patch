@@ -0,0 +1,31 @@
+import { afterEach, expect, it, vi } from "vitest";
+
+const previousStatus = process.env.ORISO_UA_STATUS_JSON;
+
+afterEach(() => {
+  if (previousStatus === undefined) delete process.env.ORISO_UA_STATUS_JSON;
+  else process.env.ORISO_UA_STATUS_JSON = previousStatus;
+  vi.resetModules();
+});
+
+async function loadStatus(raw: string | undefined) {
+  if (raw === undefined) delete process.env.ORISO_UA_STATUS_JSON;
+  else process.env.ORISO_UA_STATUS_JSON = raw;
+  vi.resetModules();
+  const { default: config } = await import("../../vite.config");
+  return config.define?.__ORISO_UA_STATUS__;
+}
+
+it.each([undefined, "", "null"])("keeps absent or null status as null (%s)", async (raw) => {
+  expect(await loadStatus(raw)).toBe("null");
+});
+
+it("preserves valid status JSON in the actual Vite definition", async () => {
+  const status = { generationId: "fixture-generation", verification: { status: "verified" } };
+  expect(await loadStatus(JSON.stringify(status))).toBe(JSON.stringify(status));
+});
+
+it("names malformed status configuration without echoing its contents", async () => {
+  await expect(loadStatus("synthetic-private-status-invalid-json"))
+    .rejects.toThrow(/^ORISO_UA_STATUS_JSON is not valid JSON$/);
+});
