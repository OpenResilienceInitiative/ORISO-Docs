+import { Children, isValidElement } from 'react';
+import { createRequire } from 'node:module';
+import type { ReactNode, ReactElement } from 'react';
+import { Handle, Position } from '@xyflow/react';
+import type { NodeProps } from '@xyflow/react';
+import { describe, expect, it } from 'vitest';
+import { ContainerNodeComponent } from '../ContainerNode';
+import type { ContainerFlowNode } from '../ContainerNode';
+
+// Exercise the exact edge-position algorithm used by the installed React Flow.
+const require = createRequire(import.meta.url);
+const xyflowRequire = createRequire(require.resolve('@xyflow/react'));
+const { getEdgePosition, ConnectionMode } = xyflowRequire('@xyflow/system');
+
+interface PortProps {
+  type?: 'source' | 'target';
+  position?: Position;
+  id?: string;
+  children?: ReactNode;
+}
+
+function ports(tree: ReactNode): ReactElement<PortProps>[] {
+  return Children.toArray(tree).flatMap(child => {
+    if (!isValidElement<PortProps>(child)) return [];
+    return child.type === Handle ? [child] : ports(child.props.children);
+  });
+}
+
+describe('container connections', () => {
+  for (const isExpanded of [false, true]) {
+    it(`retains anonymous source and target ports while ${isExpanded ? 'expanded' : 'collapsed'}`, () => {
+      const props: NodeProps<ContainerFlowNode> = {
+        id: 'container:api', type: 'container', width: 600, height: 400,
+        data: {
+          containerId: 'container:api', name: 'API', childCount: 3,
+          strategy: 'folder', colorIndex: 0, isExpanded, hasSearchHits: false,
+          isDiffAffected: false, isFocusedViaChild: false, onToggle: () => {},
+        },
+        dragging: false, draggable: false, selectable: false, deletable: false,
+        selected: false, isConnectable: false, zIndex: 0,
+        positionAbsoluteX: 0, positionAbsoluteY: 0,
+      };
+      // Inspect the actual rendered component tree. Portal and collapsed-atom
+      // edges omit sourceHandle/targetHandle, so named-only ports are insufficient.
+      const handles = ports(ContainerNodeComponent(props));
+      expect(handles.map(h => [h.props.type, h.props.position, h.props.id])).toEqual([
+        ['target', Position.Top, undefined],
+        ['source', Position.Bottom, undefined],
+      ]);
+      const measuredNode = (id: string, renderedPorts: ReactElement<PortProps>[]) => ({
+        id, measured: { width: 600, height: 400 },
+        internals: {
+          positionAbsolute: { x: 0, y: 0 },
+          handleBounds: Object.fromEntries(['source', 'target'].map(type => [type,
+            renderedPorts.filter(h => h.props.type === type).map(h => ({
+              id: null, type, nodeId: id, position: h.props.position,
+              x: 296, y: type === 'source' ? 396 : -4, width: 8, height: 8,
+            })),
+          ])),
+        },
+      });
+      const errors: string[] = [];
+      const edge = (renderedPorts: ReactElement<PortProps>[]) => getEdgePosition({
+        id: 'e-0', sourceNode: measuredNode('container:api', renderedPorts),
+        targetNode: measuredNode('container:other', handles),
+        sourceHandle: null, targetHandle: null, connectionMode: ConnectionMode.Strict,
+        onError: (code: string) => errors.push(code),
+      });
+      expect(edge([])).toBeNull();
+      expect(errors).toEqual(['008']);
+      errors.length = 0;
+      expect(edge(handles)).not.toBeNull();
+      expect(errors).toEqual([]);
+    });
+  }
+});
