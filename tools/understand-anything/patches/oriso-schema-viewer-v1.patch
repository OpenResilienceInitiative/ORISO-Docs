diff --git a/understand-anything-plugin/packages/dashboard/src/components/OrisoEvidenceStatus.tsx b/understand-anything-plugin/packages/dashboard/src/components/OrisoEvidenceStatus.tsx
new file mode 100644
index 0000000..b3f71d1
--- /dev/null
+++ b/understand-anything-plugin/packages/dashboard/src/components/OrisoEvidenceStatus.tsx
@@ -0,0 +1,32 @@
+import { useDashboardStore } from '../store';
+
+declare const __ORISO_UA_STATUS__: {
+  generationId?: string;
+  verificationScope?: string;
+  channel?: string;
+  structuralAnalyzedAt?: string;
+  semanticReviewedAt?: string | null;
+  semanticCoverage?: Record<string, number | boolean>;
+  deliveredAt?: string;
+} | null;
+
+export default function OrisoEvidenceStatus() {
+  const graph = useDashboardStore(state => state.graph);
+  if (graph?.schemaVersion !== 'oriso.ua.graph/v1') return null;
+  const status = typeof __ORISO_UA_STATUS__ !== 'undefined' ? __ORISO_UA_STATUS__ : null;
+  const sameGeneration = status?.generationId === graph.generationId;
+  return <details className="max-h-[45vh] overflow-y-auto shrink-0 border-b border-border-subtle bg-surface px-3 py-2 text-xs text-text-secondary">
+    <summary className="cursor-pointer" aria-label="Graph source and delivery evidence">
+      Source evidence · Generation {graph.generationId?.slice(0, 8) ?? 'unsealed'} · Details
+    </summary>
+    <dl className="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 mt-2 break-words">
+      <dt>Channel</dt><dd>{sameGeneration ? status?.channel : 'Not provided by the verified launcher'}</dd>
+      <dt>Structure</dt><dd>{graph.project.analyzedAt}</dd>
+      <dt>Latest claim review</dt><dd>{sameGeneration && status?.semanticReviewedAt ? status.semanticReviewedAt : 'No reviewed claims; inspect each claim'}</dd>
+      <dt>Claims</dt><dd>{sameGeneration && status?.semanticCoverage ? JSON.stringify(status.semanticCoverage) : 'Claim-specific source status; no runtime acceptance implied'}</dd>
+      <dt>Last delivery</dt><dd>{sameGeneration ? status?.deliveredAt ?? 'Unknown' : 'Unknown for this generation'}</dd>
+      <dt>Source revisions</dt><dd className="break-all">{Object.entries(graph.project.sourceCommits ?? {[graph.project.name]: graph.project.gitCommitHash}).map(([repo,sha]) => <div key={repo}>{repo}: {sha ?? 'Unknown'}</div>)}</dd>
+    </dl>
+    <p className="mt-2">{sameGeneration && status?.verificationScope === "current-source" ? "Source freshness was checked when this viewer launched. Run ua-pull --verify again after source changes. " : "Source freshness is not verified for this viewer session. Use the installed ua-dashboard launcher. "}Read individual relation labels for certainty. Overview connections summarize relations and may include hints; expand them for direction and source evidence. Test references identify source files, not passing runtime tests.</p>
+  </details>;
+}
