+++ b/understand-anything-plugin/packages/dashboard/src/components/orisoEvidenceModel.ts
@@ -0,0 +1,143 @@
+import type {
+  GraphNode,
+  KnowledgeGraph,
+} from "@understand-anything/core/types";
+export const object = (value: unknown): Record<string, unknown> =>
+  value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+export const metadata = (value: unknown) => object(object(value).metadata);
+export const text = (value: unknown) =>
+  typeof value === "string" ? value : null;
+export const isOriso = (graph: KnowledgeGraph) =>
+  graph.schemaVersion === "oriso.ua.graph/v1";
+const fullSHA = (value: unknown): value is string =>
+  typeof value === "string" && /^[a-f0-9]{40}$/i.test(value);
+const rangeOf = (value: unknown): [number, number] | null =>
+  Array.isArray(value) &&
+  value.length === 2 &&
+  value.every(Number.isSafeInteger) &&
+  value[0] >= 1 &&
+  value[1] >= value[0]
+    ? [value[0], value[1]]
+    : null;
+export function repositoryOf(
+  node: GraphNode,
+  graph: KnowledgeGraph,
+): string | null {
+  const declared = object(node).sourceRepo;
+  const repo =
+    declared !== undefined
+      ? declared
+      : node.id.includes("::")
+        ? node.id.split("::")[0]
+        : graph.project.name;
+  if (
+    typeof repo !== "string" ||
+    !/^ORISO-[A-Za-z0-9][A-Za-z0-9-]*$/.test(repo)
+  )
+    return null;
+  const observed = graph.project.sourceCommits;
+  return observed
+    ? Object.prototype.hasOwnProperty.call(observed, repo) &&
+      fullSHA(observed[repo])
+      ? repo
+      : null
+    : graph.project.name === repo && fullSHA(graph.project.gitCommitHash)
+      ? repo
+      : null;
+}
+export interface RevisionSource {
+  href: string;
+  repository: string;
+  commit: string;
+  filePath: string;
+  range: [number, number] | null;
+}
+// Never accept a URL from graph metadata. All links have this fixed origin and
+// organization; repository membership, full revision and each path segment are checked.
+export function sourceAtRevision(
+  node: GraphNode,
+  graph: KnowledgeGraph,
+  evidence?: Record<string, unknown>,
+): RevisionSource | null {
+  if (!isOriso(graph)) return null;
+  const repository = repositoryOf(node, graph);
+  const commit = evidence
+    ? evidence.sourceCommit
+    : (metadata(node).sourceCommit ??
+      graph.project.sourceCommits?.[repository ?? ""] ??
+      graph.project.gitCommitHash);
+  const filePath = node.filePath;
+  if (
+    !repository ||
+    !fullSHA(commit) ||
+    typeof filePath !== "string" ||
+    !filePath ||
+    /[\\:%\u0000-\u001f\u007f]/.test(filePath)
+  )
+    return null;
+  const segments = filePath.split("/");
+  if (segments.some((part) => !part || part === "." || part === ".."))
+    return null;
+  const rawRange = evidence ? evidence.sourceRange : node.lineRange;
+  const range = rangeOf(rawRange);
+  if (rawRange !== undefined && !range) return null;
+  let encoded: string;
+  try {
+    encoded = segments.map(encodeURIComponent).join("/");
+  } catch {
+    return null;
+  }
+  return {
+    repository,
+    commit,
+    filePath,
+    range,
+    href: `https://github.com/OpenResilienceInitiative/${repository}/blob/${commit}/${encoded}${range ? `#L${range[0]}-L${range[1]}` : ""}`,
+  };
+}
+export function evidenceRows(node: GraphNode, graph: KnowledgeGraph) {
+  const claim = object(metadata(node).semanticClaim);
+  const evidence = Array.isArray(claim.evidence) ? claim.evidence : [];
+  const repository = repositoryOf(node, graph);
+  return evidence.map((raw) => {
+    const item = object(raw),
+      id = text(item.nodeId);
+    const candidates = id
+      ? graph.nodes.filter(
+          (n) => n.id === id || (repository && n.id === `${repository}::${id}`),
+        )
+      : [];
+    const target = candidates.length === 1 ? candidates[0] : null;
+    const source =
+      target && repositoryOf(target, graph) === repository
+        ? sourceAtRevision(target, graph, item)
+        : null;
+    return {
+      id: id ?? "Unresolved evidence",
+      kind: text(item.kind) ?? "Unspecified evidence",
+      source,
+    };
+  });
+}
+export function orderedFlowSteps(node: GraphNode, graph: KnowledgeGraph) {
+  if (!isOriso(graph)) return [];
+  const edges = graph.edges.filter(
+    (e) => e.source === node.id && e.type === "contains_flow",
+  );
+  const rows = edges.map((e) => ({
+    order: metadata(e).order,
+    node: graph.nodes.find((n) => n.id === e.target),
+  }));
+  if (
+    rows.some(
+      (r) => !Number.isSafeInteger(r.order) || Number(r.order) < 1 || !r.node,
+    ) ||
+    new Set(rows.map((r) => r.order)).size !== rows.length
+  )
+    return [];
+  return rows
+    .map((r) => ({ order: Number(r.order), node: r.node! }))
+    .sort((a, b) => a.order - b.order);
+}
