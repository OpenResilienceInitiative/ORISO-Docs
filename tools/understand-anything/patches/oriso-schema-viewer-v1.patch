+  KnowledgeGraph,
+} from "@understand-anything/core/types";
+import {
+  evidenceRows,
+  isOriso,
+  metadata,
+  object,
+  orderedFlowSteps,
+  sourceAtRevision,
+  text,
+} from "./orisoEvidenceModel";
+export default function OrisoNodeEvidence({
+  node,
+  graph,
+  onSelect,
+}: {
+  node: GraphNode;
+  graph: KnowledgeGraph;
+  onSelect: (id: string) => void;
+}) {
+  if (!isOriso(graph)) return null;
+  const meta = metadata(node),
+    claim = object(meta.semanticClaim),
+    authority = object(meta.authority);
+  const source = sourceAtRevision(node, graph),
+    evidence = evidenceRows(node, graph),
+    steps = orderedFlowSteps(node, graph);
+  const branches = graph.edges.filter(
+    (e) =>
+      e.source === node.id &&
+      ["on_error", "compensates", "tested_by"].includes(e.type),
+  );
+  const hasClaim = Object.keys(claim).length > 0;
+  return (
+    <section
+      aria-label="Node source and claim evidence"
+      className="mb-4 rounded-lg border border-border-subtle bg-elevated/60 p-3 text-xs text-text-secondary space-y-2 break-words"
+    >
+      <h3 className="font-semibold text-accent">Source and claim evidence</h3>
+      {hasClaim ? (
+        <dl className="space-y-1">
+          <div>
+            <dt className="inline font-medium">Claim status: </dt>
+            <dd className="inline">{text(claim.status) ?? "unbound"}</dd>
+          </div>
+          <div>
+            <dt className="inline font-medium">Confidence: </dt>
+            <dd className="inline">
+              {text(claim.confidence) ?? "not reviewed"}
+            </dd>
+          </div>
+          <div>
+            <dt className="inline font-medium">Reviewed: </dt>
+            <dd className="inline">
+              {text(claim.reviewedAt) ?? "No review date recorded"}
+            </dd>
+          </div>
+          {text(claim.sourceCommit) && (
+            <div>
+              <dt>Claim source revision</dt>
+              <dd className="font-mono break-all">
+                {text(claim.sourceCommit)}
+              </dd>
+            </div>
+          )}
+          {text(claim.reason) && (
+            <div>
+              <dt className="sr-only">Assessment</dt>
+              <dd>{text(claim.reason)}</dd>
+            </div>
+          )}
+        </dl>
+      ) : (
+        <p>No source-bound semantic review recorded for this node.</p>
+      )}
+      {source && (
+        <p className="font-mono break-all">
+          {source.repository} · {source.commit}
+        </p>
+      )}
+      {text(meta.source) && <p>Extraction source: {text(meta.source)}</p>}
+      {Object.keys(authority).length > 0 && (
+        <p>
+          Document status: {text(authority.status) ?? "unknown"} · Owner:{" "}
+          {text(authority.owner) ?? "not declared"}. Authority depends on
+          explicit scope and supersession.
+        </p>
+      )}
+      <p>
+        Source evidence only. Test links identify test definitions; they do not
+        establish a passing execution or runtime acceptance.
+      </p>
+      {evidence.length > 0 && (
+        <details open>
+          <summary className="cursor-pointer">
+            Claim evidence ({evidence.length})
+          </summary>
+          <ul className="mt-2 space-y-2 max-h-64 overflow-y-auto">
+            {evidence.map((e, i) => (
+              <li key={`${e.id}:${i}`}>
+                {e.source ? (
+                  <>
+                    <a
+                      href={e.source.href}
+                      target="_blank"
+                      rel="noopener noreferrer"
+                      className="text-accent underline break-all"
+                    >
+                      {e.kind}: {e.source.filePath}
+                      {e.source.range
+                        ? ` · L${e.source.range[0]}–L${e.source.range[1]}`
+                        : ""}
+                    </a>
+                    <div className="font-mono text-[10px] break-all">
+                      {e.source.commit}
+                    </div>
+                  </>
+                ) : (
+                  <span>
+                    {e.kind}: {e.id} · source link unavailable
+                  </span>
+                )}
+              </li>
+            ))}
+          </ul>
+        </details>
+      )}
+      {steps.length > 0 && (
+        <div>
+          <h4 className="font-medium">Ordered source steps</h4>
+          <ol className="mt-1 space-y-1">
+            {steps.map((s) => (
+              <li key={s.node.id}>
+                <button
+                  type="button"
+                  className="text-left text-accent underline"
+                  onClick={() => onSelect(s.node.id)}
+                >
+                  {s.order}. {s.node.name}
+                </button>
+              </li>
+            ))}
+          </ol>
+        </div>
+      )}
+      {branches.length > 0 && (
+        <div className="space-y-2">
+          {branches.map((edge, i) => {
+            const target = graph.nodes.find((n) => n.id === edge.target);
+            return (
+              <div key={`${edge.target}:${i}`}>
+                <button
+                  type="button"
+                  className="text-left text-accent underline"
+                  onClick={() => onSelect(edge.target)}
+                >
+                  {edge.type === "tested_by"
+                    ? "Test source"
+                    : edge.type === "on_error"
+                      ? "On error"
+                      : "Compensation"}
+                  : {target?.name ?? edge.target}
+                </button>
+                {edge.type !== "tested_by" && target && <p>{target.summary}</p>}
+                <p className="text-[10px]">
+                  {text(metadata(edge).evidenceKind) ??
+                    "Unspecified confidence"}
+                  {edge.type === "tested_by"
+                    ? ` · Execution: ${text(metadata(edge).testExecution) ?? "not recorded"}`
+                    : ""}
+                </p>
+              </div>
+            );
+          })}
+        </div>
+      )}
+    </section>
+  );
+}
