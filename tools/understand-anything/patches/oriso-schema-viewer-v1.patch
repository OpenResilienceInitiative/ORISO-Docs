+import { readFileSync } from "node:fs";
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import OrisoNodeEvidence from "../OrisoNodeEvidence";
+import { describe, expect, it } from "vitest";
+import type {
+  KnowledgeGraph,
+  GraphNode,
+} from "@understand-anything/core/types";
+import {
+  sourceAtRevision,
+  evidenceRows,
+  orderedFlowSteps,
+} from "../orisoEvidenceModel";
+const sha = "a".repeat(40);
+const file = (extra: Record<string, unknown> = {}): GraphNode => ({
+  id: "ORISO-Test::file:src/a.ts",
+  type: "file",
+  name: "a.ts",
+  summary: "source",
+  tags: [],
+  complexity: "simple",
+  filePath: "src/a.ts",
+  lineRange: [2, 4],
+  ...{ sourceRepo: "ORISO-Test", metadata: { sourceCommit: sha } },
+  ...extra,
+});
+const graph = (): KnowledgeGraph => ({
+  version: "1.0.0",
+  schemaVersion: "oriso.ua.graph/v1",
+  project: {
+    name: "ORISO-Platform",
+    languages: [],
+    frameworks: [],
+    description: "",
+    analyzedAt: "",
+    gitCommitHash: null,
+    sourceCommits: { "ORISO-Test": sha },
+  },
+  nodes: [file()],
+  edges: [],
+  layers: [],
+  tour: [],
+});
+describe("ORISO exact revision evidence", () => {
+  it("pins the observed repository, full SHA, encoded relative file and exact range", () => {
+    const g = graph(),
+      n = file({ filePath: "docs/a #?.md" });
+    expect(sourceAtRevision(n, g)?.href).toBe(
+      `https://github.com/OpenResilienceInitiative/ORISO-Test/blob/${sha}/docs/a%20%23%3F.md#L2-L4`,
+    );
+  });
+  it("rejects unobserved repos, non-SHAs, traversal, URL/control paths and malformed ranges", () => {
+    for (const extra of [
+      { sourceRepo: "evil" },
+      { sourceRepo: "ORISO-Other" },
+      { metadata: { sourceCommit: "main" } },
+      ...[
+        "../a",
+        "/a",
+        "src/../a",
+        "src//a",
+        "src\\a",
+        "https://evil/a",
+        "src/%2e%2e/a",
+        "src/\na",
+      ].map((filePath) => ({ filePath })),
+      { lineRange: [0, 3] },
+      { lineRange: [4, 2] },
+    ])
+      expect(sourceAtRevision(file(extra), graph())).toBeNull();
+  });
+  it("does not give generic graphs an ORISO link and supports repository-only graphs", () => {
+    const g = graph();
+    delete g.schemaVersion;
+    expect(sourceAtRevision(file(), g)).toBeNull();
+    g.schemaVersion = "oriso.ua.graph/v1";
+    g.project.name = "ORISO-Test";
+    g.project.gitCommitHash = sha;
+    delete g.project.sourceCommits;
+    expect(
+      sourceAtRevision(file({ sourceRepo: undefined }), g)?.repository,
+    ).toBe("ORISO-Test");
+  });
+  it("resolves namespaced claim evidence and keeps a stale review pinned to its reviewed SHA", () => {
+    const g = graph(),
+      review = "b".repeat(40),
+      n = file({
+        id: "ORISO-Test::flow:reviewed",
+        type: "flow",
+        metadata: {
+          semanticClaim: {
+            sourceCommit: review,
+            evidence: [
+              {
+                nodeId: "file:src/a.ts",
+                sourceCommit: review,
+                sourceRange: [2, 4],
+                kind: "test-source",
+              },
+            ],
+          },
+        },
+      });
+    const rows = evidenceRows(n, g);
+    expect(rows).toHaveLength(1);
+    expect(rows[0].kind).toBe("test-source");
+    expect(rows[0].source?.href).toContain(`/blob/${review}/`);
+    expect(
+      evidenceRows(
+        file({
+          metadata: {
+            semanticClaim: {
+              evidence: [
+                { nodeId: "missing", sourceCommit: sha, kind: "source" },
+              ],
+            },
+          },
+        }),
+        g,
+      )[0].source,
+    ).toBeNull();
+  });
+  it("uses contains_flow order rather than edge weight and refuses duplicate orders", () => {
+    const g = graph(),
+      root = file({ id: "flow:r", type: "flow" }),
+      one = file({ id: "flow:1", name: "first" }),
+      two = file({ id: "flow:2", name: "second" });
+    g.nodes = [root, one, two];
+    g.edges = [
+      {
+        source: root.id,
+        target: two.id,
+        type: "contains_flow",
+        direction: "forward",
+        weight: 0.1,
+        ...{ metadata: { order: 2 } },
+      },
+      {
+        source: root.id,
+        target: one.id,
+        type: "contains_flow",
+        direction: "forward",
+        weight: 0.9,
+        ...{ metadata: { order: 1 } },
+      },
+    ];
+    expect(orderedFlowSteps(root, g).map((s) => s.node.name)).toEqual([
+      "first",
+      "second",
+    ]);
+    g.edges.push({ ...g.edges[0], target: one.id });
+    expect(orderedFlowSteps(root, g)).toEqual([]);
+  });
+});
+
+it("renders useful claim evidence without interpreting raw URLs or claiming passing tests", () => {
+  const g = graph(),
+    n = file({
+      metadata: {
+        semanticClaim: {
+          status: "stale",
+          confidence: "inferred",
+          reviewedAt: "2026-09-06T22:58:21Z",
+          sourceCommit: sha,
+          evidence: [
+            {
+              nodeId: "file:src/a.ts",
+              sourceCommit: sha,
+              sourceRange: [2, 4],
+              kind: "test-source",
+              href: "javascript:alert(1)",
+            },
+          ],
+        },
+      },
+    });
+  const html = renderToStaticMarkup(
+    createElement(OrisoNodeEvidence, { node: n, graph: g, onSelect: () => {} }),
+  );
+  expect(html).toContain("stale");
+  expect(html).toContain("inferred");
+  expect(html).toContain("test-source");
+  expect(html).toContain("do not establish a passing execution");
+  expect(html).toContain(`/blob/${sha}/src/a.ts#L2-L4`);
+  expect(html).not.toContain("javascript:");
+  delete g.schemaVersion;
+  expect(
+    renderToStaticMarkup(
+      createElement(OrisoNodeEvidence, {
+        node: n,
+        graph: g,
+        onSelect: () => {},
+      }),
+    ),
+  ).toBe("");
+});
+it.skipIf(!process.env.UA_REAL_PLATFORM_GRAPH)(
+  "all four actual platform walkthroughs show ordered steps and pinned source/test evidence",
+  () => {
+    const g: KnowledgeGraph = JSON.parse(
+      readFileSync(process.env.UA_REAL_PLATFORM_GRAPH!, "utf8"),
+    );
+    const roots = g.nodes.filter(
+      (n) =>
+        n.tags.includes("source-walkthrough") &&
+        g.edges.some((e) => e.source === n.id && e.type === "contains_flow"),
+    );
+    expect(roots).toHaveLength(4);
+    for (const root of roots) {
+      const steps = orderedFlowSteps(root, g);
+      expect(steps.length).toBeGreaterThan(1);
+      expect(steps.map((s) => s.order)).toEqual(steps.map((_, i) => i + 1));
+      const evidence = evidenceRows(root, g);
+      expect(evidence.length).toBeGreaterThan(0);
+      expect(evidence.every((e) => e.source !== null)).toBe(true);
+      expect(evidence.some((e) => e.kind === "test-source")).toBe(true);
+      const html = renderToStaticMarkup(
+        createElement(OrisoNodeEvidence, {
+          node: root,
+          graph: g,
+          onSelect: () => {},
+        }),
+      );
+      expect(html).toContain("Ordered source steps");
+      expect(html).toContain("source-current");
+      for (const step of steps)
+        expect(html).toContain(
+          step.node.name
+            .replace(/&/g, "&amp;")
+            .replace(/>/g, "&gt;")
+            .replace(/</g, "&lt;")
+            .replace(/"/g, "&quot;")
+            .replace(/'/g, "&#x27;"),
+        );
+    }
+  },
+);
