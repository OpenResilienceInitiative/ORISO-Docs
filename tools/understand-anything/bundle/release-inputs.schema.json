{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oriso.platform-release/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "releaseUrl",
    "documentationRevision",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "oriso.platform-release/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
    },
    "releaseUrl": {
      "type": "string",
      "pattern": "^https://github.com/OpenResilienceInitiative/ORISO-Helm/releases/tag/[^/?#]+$"
    },
    "documentationRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "ref",
          "sourceSHA"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "pattern": "^(refs/tags/[A-Za-z0-9_./-]+|[a-f0-9]{40})$"
          },
          "sourceSHA": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    }
  }
}
