{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oriso.ua.generation/v1",
  "$ref": "#/$defs/manifest",
  "$comment": "The shared Python validator additionally enforces full source equality, exact timestamps, graph identity/reference integrity, coverage equations, complete inventory, checksums and safe paths. It never sanitizes or drops data.",
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "summary",
        "tags",
        "complexity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "article",
            "claim",
            "class",
            "component",
            "componentSet",
            "concept",
            "config",
            "document",
            "domain",
            "endpoint",
            "entity",
            "file",
            "flow",
            "function",
            "instance",
            "module",
            "page",
            "pipeline",
            "resource",
            "schema",
            "screen",
            "service",
            "source",
            "step",
            "table",
            "token",
            "topic"
          ]
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complexity": {
          "enum": [
            "simple",
            "moderate",
            "complex"
          ]
        },
        "lineRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "filePath": {
          "type": "string"
        },
        "languageNotes": {
          "type": "string"
        },
        "domainMeta": {
          "type": "object",
          "properties": {
            "entryPoint": {
              "type": "string"
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "businessRules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "crossDomainInteractions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "entryType": {
              "enum": [
                "http",
                "cli",
                "event",
                "cron",
                "manual"
              ]
            }
          },
          "additionalProperties": true
        },
        "knowledgeMeta": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "wikilinks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "backlinks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "figmaMeta": {
          "type": "object",
          "properties": {
            "fileKey": {
              "type": "string"
            },
            "nodeId": {
              "type": "string"
            },
            "figmaType": {
              "type": "string"
            },
            "thumbnailUrl": {
              "type": "string"
            },
            "tokenValue": {
              "type": "string"
            },
            "componentKey": {
              "type": "string"
            },
            "prototypeTargets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tokenKind": {
              "enum": [
                "color",
                "type",
                "spacing",
                "effect",
                "grid"
              ]
            },
            "dimensions": {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "source",
        "target",
        "type",
        "direction",
        "weight"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "type": {
          "enum": [
            "authored_by",
            "builds_on",
            "calls",
            "calls_unconfirmed",
            "categorized_under",
            "cites",
            "compensates",
            "configures",
            "consumes",
            "contains",
            "contains_flow",
            "contradicts",
            "cross_domain",
            "defines_schema",
            "depends_on",
            "deploys",
            "documents",
            "exemplifies",
            "exports",
            "exposes",
            "flow_step",
            "governs",
            "implements",
            "imports",
            "inherits",
            "instance_of",
            "mentions",
            "middleware",
            "migrates",
            "on_error",
            "owns",
            "proposes_for",
            "provisions",
            "publishes",
            "reads_from",
            "related",
            "routes",
            "serves",
            "similar_to",
            "subscribes",
            "tested_by",
            "transforms",
            "triggers",
            "uses_token",
            "validates",
            "variant_of",
            "writes_to"
          ]
        },
        "direction": {
          "enum": [
            "forward",
            "backward",
            "bidirectional"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "ref",
        "sourceSHA",
        "fetchedAt",
        "fetchSuccess"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/heads/"
        },
        "sourceSHA": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        },
        "fetchSuccess": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "graph": {
      "type": "object",
      "required": [
        "schemaVersion",
        "generationId",
        "project",
        "nodes",
        "edges",
        "layers",
        "tour",
        "relationCoverage",
        "sourceRepositories",
        "version"
      ],
      "properties": {
        "schemaVersion": {
          "const": "oriso.ua.graph/v1"
        },
        "generationId": {
          "type": "string",
          "format": "uuid"
        },
        "project": {
          "type": "object",
          "required": [
            "name",
            "languages",
            "frameworks",
            "description",
            "analyzedAt",
            "gitCommitHash"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frameworks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string"
            },
            "analyzedAt": {
              "type": "string",
              "format": "date-time"
            },
            "gitCommitHash": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "layers": {
          "type": "array"
        },
        "tour": {
          "type": "array"
        },
        "sourceRepositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "relationCoverage": {
          "type": "object",
          "minProperties": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "generationId",
        "generatedAt",
        "sources",
        "graphs",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": "oriso.ua.generation/v1"
        },
        "generationId": {
          "type": "string",
          "format": "uuid"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "graphs": {
          "type": "array",
          "minItems": 3
        },
        "files": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  }
}
